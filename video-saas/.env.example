# Copy to .env. For internet use, generate long unique random secrets and use HTTPS.
APP_SECRET=CHANGE_ME_TO_RANDOM_64_CHARACTERS
ADMIN_PASSWORD=CHANGE_ME_TO_UNIQUE_LONG_ADMIN_PASSWORD
SITE_URL=http://localhost:8000
DOMAIN=video.example.com
CONTACT_EMAIL=hello@example.com
DAILY_LIMIT=5
MAX_WORKERS=2
MAX_DOWNLOAD_MB=250
MAX_DURATION_SECONDS=1200
FILE_TTL_HOURS=6
ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,douyin.com,www.douyin.com,v.douyin.com
# Do not enable AdSense without policy review and approved Google publisher account.
ADSENSE_ENABLED=false
ADSENSE_CLIENT=
ADSENSE_SLOT=

# Optional Google OpenID Connect sign-in. Keep OAuth disabled until a Google Cloud OAuth client is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console. Defaults to SITE_URL/auth/google/callback when empty.
GOOGLE_REDIRECT_URI=
